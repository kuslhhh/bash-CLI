{
  "name": "ksh-bash",
  "version": "2.0.0",
  "description": "Fast Windows-only CLI that maps bash-like commands to PowerShell.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "ksh": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cli",
    "powershell",
    "windows",
    "bun",
    "typescript"
  ],
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18"
  },
  "author": "Kush",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "typescript-eslint": "^8.24.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
